---
import { buildPostGraph, buildSiteGraph } from '../lib/jsonld';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  canonicalUrl?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  categoryLabel?: string;
  // AI 친화 레이어 (docs/ai-friendly-guide.md §2.1) — 전부 optional
  tldr?: string;
  faq?: { q: string; a: string }[];
  brand?: string;
  product?: string;
  certifications?: string[];
  productLink?: string;
}

const {
  title,
  description,
  ogImage,
  canonicalUrl,
  type = 'website',
  publishedDate,
  updatedDate,
  tags = [],
  categoryLabel,
  tldr,
  faq,
  brand,
  product,
  certifications,
  productLink,
} = Astro.props;

const siteUrl = 'https://jinas-holiday.vercel.app';
const fullTitle = `${title} | 지나의 휴일`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const image = ogImage || `${siteUrl}/og-default.png`;

// JSON-LD — 글 페이지는 @graph로 Article/FAQPage/Product/Breadcrumb를 관계까지 묶는다.
const jsonLd =
  type === 'article'
    ? buildPostGraph({
        siteUrl,
        canonical,
        title,
        description,
        image,
        publishedDate,
        updatedDate,
        tags,
        categoryLabel,
        tldr,
        faq,
        brand,
        product,
        certifications,
        productLink,
      })
    : buildSiteGraph(siteUrl);
---

<!-- Primary Meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content="지나의 휴일" />
{tags.length > 0 && <meta name="keywords" content={tags.join(', ')} />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<!-- Open Graph -->
<meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={image} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content="지나의 휴일" />
<meta property="og:locale" content="ko_KR" />
{publishedDate && <meta property="article:published_time" content={publishedDate.toISOString()} />}
{updatedDate && <meta property="article:modified_time" content={updatedDate.toISOString()} />}

<!-- RSS -->
<link rel="alternate" type="application/rss+xml" title="지나의 휴일 RSS" href="/rss.xml" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

<!-- Fonts -->
<link
  rel="stylesheet"
  as="style"
  crossorigin
  href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
/>
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@500;700&display=swap"
/>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
