---
export const prerender = true;

import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="페이지를 찾을 수 없어요" description="요청하신 페이지가 존재하지 않습니다.">
  <section class="not-found container">
    <h1>404</h1>
    <p>앗, 찾으시는 페이지가 없어요!</p>
    <a href="/" class="home-link">홈으로 돌아가기</a>
  </section>
</BaseLayout>

<style>
  .not-found {
    text-align: center;
    padding: 6rem 0;
  }

  .not-found h1 {
    font-size: 5rem;
    color: var(--color-accent);
    line-height: 1;
  }

  .not-found p {
    margin-top: 1rem;
    font-size: 1.2rem;
    color: var(--color-text-light);
  }

  .home-link {
    display: inline-block;
    margin-top: 2rem;
    padding: 0.8rem 2rem;
    background: var(--color-accent);
    color: #fff;
    border-radius: var(--radius);
    font-weight: 600;
    transition: background 0.2s;
  }

  .home-link:hover {
    background: #c5845c;
    opacity: 1;
  }
</style>
