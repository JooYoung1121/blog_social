---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import CategoryFilter from '../components/CategoryFilter.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

---

<BaseLayout title="홈">
  <section class="hero container">
    <p class="hero-eyebrow">육아 · 일상 · 솔직 리뷰</p>
    <h1>지나의 휴일</h1>
  </section>

  <section class="posts-grid container">
    <CategoryFilter />
    {posts.length === 0 && <p class="empty">아직 글이 없어요. 첫 글을 기다려주세요!</p>}
    <div class="grid">
      {posts.map((post) => (
        <PostCard
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          category={post.data.category}
          thumbnail={post.data.thumbnail}
          slug={post.id}
          sponsored={post.data.sponsored}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    text-align: center;
    padding: 3.5rem 0 2.5rem;
    background: linear-gradient(180deg, var(--color-accent-light) 0%, transparent 100%);
    border-radius: 0 0 2rem 2rem;
    margin-bottom: 1rem;
  }

  .hero-eyebrow {
    font-size: 0.85rem;
    color: var(--color-accent);
    font-weight: 600;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .hero h1 {
    font-size: 2.8rem;
    font-family: var(--font-serif);
    background: linear-gradient(135deg, var(--color-text) 0%, var(--color-accent) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }


  .posts-grid {
    padding-bottom: 3rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .empty {
    text-align: center;
    color: var(--color-text-light);
    margin-top: 3rem;
  }

  @media (max-width: 900px) {
    .grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media (max-width: 600px) {
    .grid { grid-template-columns: 1fr; }
    .hero h1 { font-size: 2rem; }
    .hero { padding: 2.5rem 0 2rem; }
  }
</style>
