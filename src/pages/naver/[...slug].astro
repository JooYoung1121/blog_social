---
export const prerender = true;

import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;

const categoryLabels: Record<string, string> = {
  'baby-products': '육아용품 리뷰',
  parenting: '육아일기',
  'daily-life': '일상',
  food: '맛집/요리',
  travel: '여행/나들이',
};

// ──────────────────────────────────────────────
// 본문(raw markdown)을 "네이버 업로드 블록"으로 분절.
//  - 사진(![](...))과 영상 마커(<!-- video -->)를 경계로 텍스트를 끊는다.
//  - 네이버 에디터 흐름(텍스트 → 사진 → 텍스트)에 맞춰 블록 단위로 복사.
//  - 네이버는 마크다운/외부 이미지를 그대로 못 받으므로:
//      · 텍스트는 마크다운 기호를 제거한 plain text로 제공
//      · 사진은 input 원본에서 직접 업로드하도록 위치 마커만 표시
// ──────────────────────────────────────────────
type Block =
  | { kind: 'text'; text: string }
  | { kind: 'photo'; index: number; label: string; isThumb: boolean }
  | { kind: 'video'; note: string };

const imgRe = /^\s*!\[[^\]]*\]\([^)]*\)\s*$/;
const videoRe = /^\s*<!--\s*video:?\s*(.*?)\s*-->\s*$/i;

function mdToPlain(s: string): string {
  return s
    .replace(/^#{1,6}\s+/gm, '') // 헤딩 기호 제거
    .replace(/^>\s?/gm, '') // 인용블록 기호 제거
    .replace(/\*\*(.+?)\*\*/g, '$1') // 굵게
    .replace(/__(.+?)__/g, '$1')
    .replace(/(?<!\*)\*(?!\*)([^*]+?)\*(?!\*)/g, '$1') // 기울임
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '$1') // 링크 → 텍스트
    .replace(/`([^`]+)`/g, '$1') // 인라인 코드
    .replace(/\n{3,}/g, '\n\n'); // 빈 줄 3개+ → 2개
}

const blocks: Block[] = [];
let buf: string[] = [];
let photoCount = 0;

function flush() {
  const text = mdToPlain(buf.join('\n')).trim();
  if (text) blocks.push({ kind: 'text', text });
  buf = [];
}

for (const line of (post.body ?? '').split('\n')) {
  if (imgRe.test(line)) {
    flush();
    photoCount++;
    blocks.push({
      kind: 'photo',
      index: photoCount,
      label: `photo_${String(photoCount).padStart(2, '0')}`,
      isThumb: photoCount === 1,
    });
  } else if (videoRe.test(line)) {
    flush();
    blocks.push({ kind: 'video', note: (line.match(videoRe)?.[1] || '').trim() });
  } else {
    buf.push(line);
  }
}
flush();

const photoTotal = blocks.filter((b) => b.kind === 'photo').length;
const videoTotal = blocks.filter((b) => b.kind === 'video').length;
const tagsLine = post.data.tags.map((t) => `#${t}`).join(' ');
const sponsorInfo = post.data.sponsorInfo;
const isSponsored =
  post.data.purchaseType === 'sponsored' ||
  post.data.purchaseType === 'gifted' ||
  post.data.purchaseType === 'service-experience' ||
  post.data.sponsored;
---

<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>{post.data.title} — 네이버 업로드 모드</title>
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;700&display=swap"
    />
    <style>
      * { box-sizing: border-box; }
      body {
        font-family: 'Noto Sans KR', sans-serif;
        max-width: 640px;
        margin: 0 auto;
        padding: 1rem 0.9rem 4rem;
        line-height: 1.85;
        color: #2b2b2b;
        background: #fafafa;
      }
      .guide {
        background: #eef6ff;
        border: 1px solid #cfe3fb;
        padding: 0.9rem 1rem;
        margin-bottom: 1.5rem;
        border-radius: 12px;
        font-size: 0.85rem;
      }
      .guide h3 { margin: 0 0 0.5rem; font-size: 0.95rem; }
      .guide ol { padding-left: 1.1rem; margin: 0.4rem 0 0; }
      .guide .meta { margin: 0.3rem 0; }
      .copy-row {
        display: flex;
        align-items: stretch;
        gap: 0.5rem;
        margin: 0.6rem 0;
      }
      .copy-src {
        flex: 1;
        background: #fff;
        border: 1px solid #e3e3e3;
        border-radius: 10px;
        padding: 0.7rem 0.85rem;
        white-space: pre-wrap;
        word-break: break-word;
        font-size: 1rem;
        line-height: 1.85;
      }
      .copy-src.title { font-weight: 700; font-size: 1.1rem; }
      .copy-src.tags { color: #1a73e8; font-size: 0.92rem; }
      .copy-btn {
        flex: 0 0 auto;
        align-self: flex-start;
        position: sticky;
        top: 0.5rem;
        min-width: 56px;
        padding: 0.55rem 0.6rem;
        border: none;
        border-radius: 10px;
        background: #03c75a; /* 네이버 그린 */
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        cursor: pointer;
      }
      .copy-btn:active { transform: scale(0.96); }
      .copy-btn.done { background: #1a73e8; }
      .section-label {
        font-size: 0.78rem;
        font-weight: 700;
        color: #888;
        margin: 1.4rem 0 0.2rem;
        letter-spacing: 0.02em;
      }
      .marker {
        margin: 0.9rem 0;
        padding: 0.7rem 0.9rem;
        border-radius: 10px;
        font-size: 0.9rem;
        font-weight: 700;
      }
      .marker.photo {
        background: #fff4e5;
        border: 1px dashed #f0b96b;
        color: #b9722a;
      }
      .marker.photo.thumb {
        background: #ffe9ec;
        border-color: #f29cab;
        color: #c0405a;
      }
      .marker.video {
        background: #eef0ff;
        border: 1px dashed #9aa6f0;
        color: #4453c7;
      }
      .disclosure {
        background: #fffbe6;
        border: 1px solid #f3e3a0;
        border-radius: 8px;
        font-size: 0.82rem;
        color: #8a6d00;
      }
      hr { border: none; border-top: 1px solid #eee; margin: 1.6rem 0; }
    </style>
  </head>
  <body>
    <div class="guide">
      <h3>📋 네이버 업로드 모드</h3>
      <p class="meta"><strong>카테고리:</strong> {categoryLabels[post.data.category]}</p>
      <p class="meta">
        <strong>사진:</strong> {photoTotal}장
        {videoTotal > 0 && <> · <strong>영상 마커:</strong> {videoTotal}개</>}
      </p>
      <p class="meta" style="margin-top:0.6rem;"><strong>사용법</strong></p>
      <ol>
        <li>텍스트 블록의 <b>[복사]</b> → 네이버 에디터에 붙여넣기</li>
        <li>🟧 <b>사진 마커</b>가 나오면 그 위치에 해당 사진을 직접 업로드 (input 원본 사용)</li>
        <li>🟦 <b>영상 마커</b>가 나오면 그 위치에 영상 삽입 (네이버는 영상 포함 글에 가점)</li>
        <li>위→아래 순서대로 반복하면 글 한 편 완성</li>
      </ol>
    </div>

    <div class="section-label">제목</div>
    <div class="copy-row">
      <div class="copy-src title">{post.data.title}</div>
      <button class="copy-btn" type="button">복사</button>
    </div>

    {tagsLine && (
      <>
        <div class="section-label">태그 (본문 맨 끝 또는 태그칸에)</div>
        <div class="copy-row">
          <div class="copy-src tags">{tagsLine}</div>
          <button class="copy-btn" type="button">복사</button>
        </div>
      </>
    )}

    {isSponsored && sponsorInfo && (
      <>
        <div class="section-label">⚠️ 협찬 고지 (상단 1회 — 법정/가이드 요구 시)</div>
        <div class="copy-row">
          <div class="copy-src disclosure">{sponsorInfo}</div>
          <button class="copy-btn" type="button">복사</button>
        </div>
      </>
    )}

    {post.data.productLink && (
      <>
        <div class="section-label">🔗 제품 링크</div>
        <div class="copy-row">
          <div class="copy-src" style="font-size:0.85rem;">{post.data.productLink}</div>
          <button class="copy-btn" type="button">복사</button>
        </div>
      </>
    )}

    <hr />
    <div class="section-label">본문 (블록 순서대로 복붙)</div>

    {blocks.map((block) =>
      block.kind === 'text' ? (
        <div class="copy-row">
          <div class="copy-src">{block.text}</div>
          <button class="copy-btn" type="button">복사</button>
        </div>
      ) : block.kind === 'photo' ? (
        <div class={`marker photo${block.isThumb ? ' thumb' : ''}`}>
          📷 여기 <b>{block.label}</b> 사진 삽입{block.isThumb ? ' (썸네일/대표)' : ''}
        </div>
      ) : (
        <div class="marker video">
          🎬 여기 영상 삽입{block.note ? ` — ${block.note}` : ''}
        </div>
      )
    )}

    <script is:inline>
      document.querySelectorAll('.copy-btn').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const src = btn.closest('.copy-row')?.querySelector('.copy-src');
          if (!src) return;
          const text = src.innerText;
          try {
            await navigator.clipboard.writeText(text);
          } catch {
            const ta = document.createElement('textarea');
            ta.value = text;
            ta.style.position = 'fixed';
            ta.style.opacity = '0';
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
          }
          const original = btn.textContent;
          btn.textContent = '복사됨';
          btn.classList.add('done');
          setTimeout(() => {
            btn.textContent = original;
            btn.classList.remove('done');
          }, 1200);
        });
      });
    </script>
  </body>
</html>
