---
export const prerender = false;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>새 글 작성 | 관리자</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <header>
      <h1>새 글 작성</h1>
      <div class="header-actions">
        <button id="btn-test-fill" class="btn-ghost" type="button" title="하베브릭스 글 데이터로 폼 자동 입력 (사진 업로드 스킵)">🧪 테스트 데이터</button>
        <button id="logout" class="btn-ghost">로그아웃</button>
      </div>
    </header>

    <main>
      <!-- Step 0: 기존 글 수정 -->
      <section class="step">
        <h2>0. 기존 글 수정 (선택)</h2>
        <p class="hint">
          발행된 글을 불러와 고칠 수 있어요. 저장 위치는 원래 경로 그대로 유지되고,
          frontmatter의 <code>updated</code> 날짜가 자동으로 갱신됩니다.
        </p>
        <div class="grid-2">
          <label>발행된 글
            <select id="post-select">
              <option value="">— 새 글 작성 —</option>
            </select>
          </label>
          <label>&nbsp;
            <button id="btn-load" class="btn-ghost" type="button" style="margin-top:0.4rem;">📥 불러오기</button>
          </label>
        </div>
        <p id="load-status" class="status" hidden></p>
      </section>

      <!-- Step 1: 사진 업로드 -->
      <section class="step">
        <h2>1. 사진 업로드</h2>
        <p class="hint">JPEG/PNG/WebP, 최대 10MB. 톤 보정 자동 적용 (해제하려면 체크박스).</p>
        <label class="row">
          <input type="checkbox" id="no-tone" /> 사진 톤 보정 끄기
        </label>
        <input type="file" id="photo-input" accept="image/jpeg,image/png,image/webp" multiple />
        <div id="upload-progress" class="progress" hidden></div>
        <div id="photo-grid" class="photo-grid"></div>
      </section>

      <!-- Step 2: 메타 정보 -->
      <section class="step">
        <h2>2. 메타 정보</h2>
        <div class="grid-2">
          <label>주제 / 핵심 한 줄
            <input type="text" id="topic" placeholder="예: 하베브릭스 아기체육관 100일 후기" />
          </label>
          <label>슬러그 (URL 식별자)
            <input type="text" id="slug" placeholder="자동: YYYY-MM-DD-주제" />
          </label>
        </div>

        <div class="grid-2">
          <label>카테고리
            <select id="category">
              <option value="baby-products">육아용품 리뷰</option>
              <option value="parenting">육아일기</option>
              <option value="daily-life">일상</option>
              <option value="food">맛집/요리</option>
              <option value="travel">여행/나들이</option>
            </select>
          </label>
          <label>구매 형태
            <select id="purchase-type">
              <option value="self-purchased">직접 구매 (가격 표기 OK)</option>
              <option value="sponsored">협찬 (원고료+제품)</option>
              <option value="gifted">무상 제공</option>
              <option value="service-experience">체험단 (서비스/장소)</option>
            </select>
          </label>
        </div>

        <div class="grid-2">
          <label>의도 (intent)
            <select id="intent">
              <option value="review">review (리뷰)</option>
              <option value="compare">compare (비교)</option>
              <option value="info">info (정보)</option>
              <option value="location">location (장소)</option>
              <option value="diary">diary (일기)</option>
            </select>
          </label>
          <label>타겟 (target)
            <select id="target">
              <option value="search">search (검색 상위노출)</option>
              <option value="homefeed">homefeed (홈피드)</option>
              <option value="both">both (둘 다)</option>
            </select>
          </label>
        </div>

        <label>메인 키워드
          <input type="text" id="main-keyword" placeholder="예: 하베브릭스 아기체육관" />
        </label>

        <label>서브 키워드 (한 줄에 하나씩, 2~5개)
          <textarea id="sub-keywords" rows="4" placeholder="바람개비 아기체육관&#10;신생아 장난감&#10;감각 발달"></textarea>
        </label>

        <label>본인 경험 메모 (가장 중요 — 디테일 풍부할수록 글 품질↑)
          <textarea id="notes" rows="8" placeholder="- 산후도우미 이모님이 추천해주셔서 알게 됐어요&#10;- 봄이가 처음엔 누워서 발로 차다가 4개월부터 손으로 잡고 놀기 시작&#10;- 단점: 매트가 살짝 미끄러움 — 러그 위에 깔아서 해결&#10;- 꿀팁: 모빌은 밤에 떼면 더 잘 잠"></textarea>
        </label>

        <div class="grid-2">
          <label>제품 링크 (선택)
            <input type="url" id="product-url" placeholder="https://..." />
          </label>
          <label>협찬 정보 (협찬일 때만)
            <input type="text" id="sponsor" placeholder="브랜드명으로부터 제품을 협찬받아" />
          </label>
        </div>

        <label>체험단 가이드 (있으면 — 최우선 반영)
          <textarea id="client-guide" rows="6" placeholder="필수 키워드, 멘션, 해시태그, 링크 등"></textarea>
        </label>
      </section>

      <!-- Step 3: AI 생성 -->
      <section class="step">
        <h2>3. AI 초안 생성</h2>
        <button id="btn-generate" class="btn-primary" disabled>🤖 AI로 초안 생성</button>
        <p id="gen-status" class="status" hidden></p>
      </section>

      <!-- Step 4: 미리보기 / 수정 -->
      <section class="step">
        <h2>4. 미리보기 & 수정</h2>
        <textarea id="markdown" rows="24" placeholder="AI가 생성한 마크다운이 여기 표시됩니다. 수정 가능."></textarea>
        <button id="btn-lint" class="btn-ghost" type="button" style="margin-top:0.6rem;">🔍 룰 검사 (lint)</button>
        <div id="lint-result" class="lint" hidden></div>
      </section>

      <!-- Step 5: 발행 -->
      <section class="step">
        <h2>5. main 브랜치에 발행</h2>
        <p class="hint">⚠️ 발행하면 즉시 main에 push됩니다 → Vercel 자동 배포.</p>
        <button id="btn-publish" class="btn-primary" disabled>📤 발행 (main에 commit & push)</button>
        <p id="publish-status" class="status" hidden></p>
      </section>
    </main>

    <script>
      // ─── State ──────────────────────────────
      interface UploadedPhoto { url: string; index: number }
      const state: {
        photos: UploadedPhoto[];
        markdown: string;
        /** 수정 모드일 때 불러온 파일의 sha (동시 수정 충돌 감지용) */
        sha: string | null;
        mode: 'new' | 'edit';
      } = {
        photos: [],
        markdown: '',
        sha: null,
        mode: 'new',
      };

      // ─── DOM ────────────────────────────────
      const $ = <T extends HTMLElement = HTMLElement>(id: string) =>
        document.getElementById(id) as T;
      const photoInput = $<HTMLInputElement>('photo-input');
      const photoGrid = $('photo-grid');
      const noToneCb = $<HTMLInputElement>('no-tone');
      const uploadProgress = $('upload-progress');
      const slugInput = $<HTMLInputElement>('slug');
      const topicInput = $<HTMLInputElement>('topic');
      const btnGenerate = $<HTMLButtonElement>('btn-generate');
      const btnPublish = $<HTMLButtonElement>('btn-publish');
      const genStatus = $('gen-status');
      const publishStatus = $('publish-status');
      const markdownEl = $<HTMLTextAreaElement>('markdown');
      const logoutBtn = $('logout');

      // ─── Slug auto-generation ───────────────
      function generateSlug(title: string): string {
        const date = new Date().toISOString().slice(0, 10);
        const s = title
          .toLowerCase()
          .replace(/[^a-z0-9가-힣\s-]/g, '')
          .replace(/\s+/g, '-')
          .slice(0, 50);
        return s ? `${date}-${s}` : `${date}-untitled`;
      }
      topicInput.addEventListener('input', () => {
        if (!slugInput.dataset.manual) {
          slugInput.value = generateSlug(topicInput.value);
        }
      });
      slugInput.addEventListener('input', () => {
        slugInput.dataset.manual = '1';
      });

      // ─── Photo upload ───────────────────────
      photoInput.addEventListener('change', async () => {
        const files = Array.from(photoInput.files || []);
        if (files.length === 0) return;
        const slug = slugInput.value || generateSlug(topicInput.value || 'untitled');
        if (!slugInput.value) slugInput.value = slug;

        uploadProgress.hidden = false;
        for (let i = 0; i < files.length; i++) {
          const file = files[i];
          const idx = state.photos.length + 1;
          uploadProgress.textContent = `업로드 중 ${i + 1}/${files.length}: ${file.name}`;

          const fd = new FormData();
          fd.append('file', file);
          fd.append('slug', slug);
          fd.append('index', String(idx).padStart(2, '0'));
          fd.append('noTone', String(noToneCb.checked));

          try {
            const res = await fetch('/srv/admin/upload-image', { method: 'POST', body: fd });
            const json = await res.json();
            if (!res.ok) throw new Error(json.error || 'upload failed');
            state.photos.push({ url: json.url, index: idx });
            renderPhotos();
          } catch (err) {
            uploadProgress.textContent = `❌ ${file.name}: ${err instanceof Error ? err.message : err}`;
            await new Promise((r) => setTimeout(r, 2000));
          }
        }
        uploadProgress.hidden = true;
        photoInput.value = '';
        btnGenerate.disabled = state.photos.length === 0;
      });

      function renderPhotos() {
        photoGrid.innerHTML = '';
        for (const p of state.photos) {
          const wrap = document.createElement('div');
          wrap.className = 'photo';
          const img = document.createElement('img');
          img.src = p.url;
          img.loading = 'lazy';
          img.alt = `사진 ${p.index}`;
          wrap.appendChild(img);
          const del = document.createElement('button');
          del.textContent = '×';
          del.className = 'photo-del';
          del.title = '제거';
          del.onclick = () => {
            state.photos = state.photos.filter((x) => x !== p);
            renderPhotos();
            btnGenerate.disabled = state.photos.length === 0;
          };
          wrap.appendChild(del);
          photoGrid.appendChild(wrap);
        }
      }

      // ─── Generate ───────────────────────────
      btnGenerate.addEventListener('click', async () => {
        btnGenerate.disabled = true;
        btnPublish.disabled = true;
        genStatus.hidden = false;
        genStatus.className = 'status';
        genStatus.textContent = '🤖 Claude가 초안을 작성하고 있어요... (30~60초)';

        const subKeywords = ($('sub-keywords') as HTMLTextAreaElement).value
          .split('\n').map((s) => s.trim()).filter(Boolean);

        try {
          const res = await fetch('/srv/admin/generate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              category: ($('category') as HTMLSelectElement).value,
              purchaseType: ($('purchase-type') as HTMLSelectElement).value,
              intent: ($('intent') as HTMLSelectElement).value,
              target: ($('target') as HTMLSelectElement).value,
              topic: topicInput.value,
              mainKeyword: ($('main-keyword') as HTMLInputElement).value,
              subKeywords,
              notes: ($('notes') as HTMLTextAreaElement).value,
              productUrl: ($('product-url') as HTMLInputElement).value,
              sponsor: ($('sponsor') as HTMLInputElement).value,
              clientGuide: ($('client-guide') as HTMLTextAreaElement).value,
              imageUrls: state.photos.map((p) => p.url),
            }),
          });
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || 'generation failed');
          state.markdown = json.markdown;
          markdownEl.value = json.markdown;
          const u = json.usage;
          const totalIn = u.input + u.cache_create + u.cache_read;
          genStatus.className = 'status success';
          genStatus.textContent = `✅ 생성 완료. 토큰: 입력 ${totalIn.toLocaleString()} (캐시 읽기 ${u.cache_read.toLocaleString()}) / 출력 ${u.output.toLocaleString()}`;
          btnPublish.disabled = false;
          await runLint();
        } catch (err) {
          genStatus.className = 'status error';
          genStatus.textContent = `❌ ${err instanceof Error ? err.message : err}`;
        } finally {
          btnGenerate.disabled = false;
        }
      });

      // 마크다운 수정 시에도 발행 가능
      markdownEl.addEventListener('input', () => {
        state.markdown = markdownEl.value;
        btnPublish.disabled = !state.markdown.trim();
      });

      // ─── 기존 글 불러오기 (수정 모드) ───────
      const postSelect = $<HTMLSelectElement>('post-select');
      const btnLoad = $<HTMLButtonElement>('btn-load');
      const loadStatus = $('load-status');

      function setMode(mode: 'new' | 'edit') {
        state.mode = mode;
        btnPublish.textContent =
          mode === 'edit'
            ? '📤 수정 발행 (기존 경로에 덮어쓰기)'
            : '📤 발행 (main에 commit & push)';
      }

      (async () => {
        try {
          const res = await fetch('/srv/admin/posts');
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || 'load failed');
          for (const p of json.posts as { slug: string; path: string }[]) {
            const opt = document.createElement('option');
            opt.value = p.slug;
            opt.textContent = p.slug;
            opt.title = p.path;
            postSelect.appendChild(opt);
          }
        } catch (err) {
          loadStatus.hidden = false;
          loadStatus.className = 'status error';
          loadStatus.textContent = `글 목록을 못 불러왔어요: ${err instanceof Error ? err.message : err}`;
        }
      })();

      btnLoad.addEventListener('click', async () => {
        const slug = postSelect.value;
        loadStatus.hidden = false;
        loadStatus.className = 'status';

        if (!slug) {
          state.sha = null;
          setMode('new');
          loadStatus.textContent = '새 글 작성 모드로 돌아왔어요.';
          return;
        }

        loadStatus.textContent = '📥 불러오는 중...';
        try {
          const res = await fetch(`/srv/admin/posts?slug=${encodeURIComponent(slug)}`);
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || 'load failed');
          state.markdown = json.markdown;
          state.sha = json.sha;
          markdownEl.value = json.markdown;
          slugInput.value = slug;
          slugInput.dataset.manual = '1';
          setMode('edit');
          btnPublish.disabled = false;
          loadStatus.className = 'status success';
          loadStatus.textContent = `✅ 불러왔어요 — ${json.path} (수정 후 5단계에서 발행)`;
          await runLint();
        } catch (err) {
          loadStatus.className = 'status error';
          loadStatus.textContent = `❌ ${err instanceof Error ? err.message : err}`;
        }
      });

      // ─── 룰 검사 (lint) ─────────────────────
      const btnLint = $<HTMLButtonElement>('btn-lint');
      const lintResult = $('lint-result');

      async function runLint() {
        if (!state.markdown.trim()) return;
        lintResult.hidden = false;
        lintResult.className = 'lint';
        lintResult.textContent = '🔍 검사 중...';
        try {
          const res = await fetch('/srv/admin/lint', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ markdown: state.markdown }),
          });
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || 'lint failed');

          const issues = json.issues as { level: string; code: string; message: string }[];
          const errors = issues.filter((i) => i.level === 'error');
          const warnings = issues.filter((i) => i.level === 'warning');
          const s = json.stats;

          lintResult.innerHTML = '';
          const summary = document.createElement('p');
          summary.className = 'lint-summary';
          summary.textContent =
            `본문 ${s.charCount}자 · 사진 ${s.photoCount}장 · 영상 마커 ${s.videoMarkers}개 — ` +
            `에러 ${errors.length} / 경고 ${warnings.length}`;
          lintResult.appendChild(summary);

          for (const i of [...errors, ...warnings]) {
            const row = document.createElement('div');
            row.className = `lint-item ${i.level}`;
            row.textContent = `${i.level === 'error' ? '❌' : '⚠️'} [${i.code}] ${i.message}`;
            lintResult.appendChild(row);
          }
          if (issues.length === 0) {
            const ok = document.createElement('div');
            ok.className = 'lint-item ok';
            ok.textContent = '✅ 룰 위반 없음';
            lintResult.appendChild(ok);
          }
        } catch (err) {
          lintResult.className = 'lint error';
          lintResult.textContent = `❌ ${err instanceof Error ? err.message : err}`;
        }
      }

      btnLint.addEventListener('click', runLint);

      // ─── Publish ────────────────────────────
      btnPublish.addEventListener('click', async () => {
        const slug = slugInput.value || generateSlug(topicInput.value || 'untitled');
        const confirmMsg =
          state.mode === 'edit'
            ? `기존 글을 수정 발행할까요?\n\nslug: ${slug}\n(원래 저장 경로에 덮어쓰고 updated 날짜가 갱신됩니다)`
            : `main 브랜치에 발행할까요?\n\n경로: src/content/posts/YYYY/MM/${slug}.md`;
        if (!confirm(confirmMsg)) return;

        btnPublish.disabled = true;
        publishStatus.hidden = false;
        publishStatus.className = 'status';
        publishStatus.textContent = '📤 GitHub에 커밋 중...';

        try {
          const res = await fetch('/srv/admin/publish', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ slug, markdown: state.markdown, sha: state.sha }),
          });
          const json = await res.json();
          if (!res.ok) throw new Error(json.error || 'publish failed');
          state.sha = null;
          publishStatus.className = 'status success';
          publishStatus.innerHTML =
            `✅ ${json.mode === 'update' ? '수정' : '발행'} 완료! ` +
            `<a href="${json.commitUrl}" target="_blank" rel="noopener">커밋 보기</a> · ` +
            `<a href="${json.naverUrl}" target="_blank" rel="noopener">네이버 업로드 모드 열기</a> · ` +
            `1~2분 후 반영됩니다. (경로: ${json.path})`;
        } catch (err) {
          publishStatus.className = 'status error';
          publishStatus.textContent = `❌ ${err instanceof Error ? err.message : err}`;
          btnPublish.disabled = false;
        }
      });

      // ─── Logout ─────────────────────────────
      logoutBtn.addEventListener('click', async () => {
        await fetch('/srv/admin/logout', { method: 'POST' });
        location.href = '/admin/login';
      });

      // ─── 🧪 테스트 데이터 자동 입력 (임시) ───
      const btnTestFill = $<HTMLButtonElement>('btn-test-fill');
      btnTestFill.addEventListener('click', () => {
        const base = 'https://res.cloudinary.com/diztnbres/image/upload/f_auto,q_auto/v1776998';
        const dir = '/blog/2026/04/2026-04-24-%ED%95%98%EB%B2%A0%EB%B8%8C%EB%A6%AD%EC%8A%A4-%EC%95%84%EA%B8%B0%EC%B2%B4%EC%9C%A1%EA%B4%80-%EB%B0%94%EB%9E%8C%EA%B0%9C%EB%B9%84-%EC%A7%81%EC%A0%91%EA%B5%AC%EB%A7%A4-%EB%A6%AC%EB%B7%B0';
        // 토큰 절약 위해 5장만 사용 (전체는 21장)
        const photos = [
          `${base}458${dir}/photo_01.jpg`,
          `${base}459${dir}/photo_02.jpg`,
          `${base}460${dir}/photo_04.jpg`,
          `${base}464${dir}/photo_09.jpg`,
          `${base}471${dir}/photo_19.jpg`,
        ];
        state.photos = photos.map((url, i) => ({ url, index: i + 1 }));
        renderPhotos();

        topicInput.value = '테스트: 하베브릭스 아기체육관 자동 생성';
        slugInput.value = `test-${new Date().toISOString().slice(0, 10)}-harbebricks-auto`;
        ($('category') as HTMLSelectElement).value = 'baby-products';
        ($('purchase-type') as HTMLSelectElement).value = 'self-purchased';
        ($('intent') as HTMLSelectElement).value = 'review';
        ($('target') as HTMLSelectElement).value = 'search';
        ($('main-keyword') as HTMLInputElement).value = '하베브릭스 아기체육관';
        ($('sub-keywords') as HTMLTextAreaElement).value = '바람개비아기체육관\n신생아장난감\n감각발달';
        ($('notes') as HTMLTextAreaElement).value = [
          '- 봄이가 2개월 됐을 때 하루 종일 안고 있어야 했음',
          '- 산후도우미 이모님 추천으로 알게 됨',
          '- 처음엔 누워서 발로 차다가 점점 손으로 잡고 놀기 시작',
          '- 모빌이 바람개비 모양이라 봄이가 신기해함',
          '- 매트는 살짝 미끄러워서 러그 위에 깔아서 사용',
          '- 한 달 정도 사용했는데 만족도 매우 높음',
          '- 단점: 부피가 커서 보관이 살짝 불편',
        ].join('\n');
        ($('product-url') as HTMLInputElement).value = '';
        ($('sponsor') as HTMLInputElement).value = '';
        ($('client-guide') as HTMLTextAreaElement).value = '';

        btnGenerate.disabled = false;
        alert('테스트 데이터 입력 완료!\n사진 5장(Cloudinary 재활용) + 메타 정보가 채워졌습니다.\n\n"🤖 AI로 초안 생성" 버튼을 눌러 ANTHROPIC_API_KEY 동작을 확인하세요.\n\n⚠️ 발행 단계는 GITHUB_REPO_TOKEN 필요. 발행 안 하시려면 4단계에서 멈추세요.');
      });
    </script>

    <style>
