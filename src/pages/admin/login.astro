---
export const prerender = false;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex" />
    <title>관리자 로그인 | 지나의 휴일</title>
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
  </head>
  <body>
    <main>
      <form id="login-form">
        <h1>관리자 로그인</h1>
        <input
          type="password"
          id="password"
          name="password"
          placeholder="비밀번호"
          autofocus
          required
        />
        <button type="submit">로그인</button>
        <p id="error" class="error" hidden></p>
      </form>
    </main>

    <script>
      const form = document.getElementById('login-form') as HTMLFormElement;
      const errorEl = document.getElementById('error') as HTMLParagraphElement;

      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        errorEl.hidden = true;
        const password = (document.getElementById('password') as HTMLInputElement).value;
        const res = await fetch('/srv/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });
        const data = await res.json().catch(() => ({}));
        console.log('[login response]', res.status, data);
        if (res.ok) {
          location.href = '/admin';
        } else {
          // TEMP DEBUG: 디버그 정보 화면에 노출 (진단 후 제거)
          const dbg = (data as any)._debug
            ? ` (env=${(data as any)._debug.envSet}/${(data as any)._debug.envLen}, secret=${(data as any)._debug.sessionSecretSet}/${(data as any)._debug.sessionSecretLen}, input=${(data as any)._debug.inputType}/${(data as any)._debug.inputLen})`
            : '';
          errorEl.textContent = `비밀번호가 올바르지 않습니다.${dbg}`;
          errorEl.hidden = false;
        }
      });
    </script>

    <style>
      body {
        margin: 0;
        font-family: 'Pretendard Variable', -apple-system, sans-serif;
        background: #faf8f5;
        color: #3d3225;
        display: grid;
        place-items: center;
        min-height: 100vh;
      }
      main {
        width: 100%;
        max-width: 360px;
        padding: 2rem;
      }
      form {
        background: #fff;
        padding: 2rem;
        border-radius: 16px;
        box-shadow: 0 8px 24px rgba(61, 50, 37, 0.08);
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }
      h1 {
        margin: 0 0 0.5rem;
        font-size: 1.3rem;
        font-weight: 700;
      }
      input {
        padding: 0.75rem 1rem;
        font-size: 1rem;
        border: 1px solid #e8e0d6;
        border-radius: 8px;
        font-family: inherit;
      }
      input:focus {
        outline: 2px solid #d4956a;
        outline-offset: 2px;
        border-color: transparent;
      }
      button {
        padding: 0.8rem 1rem;
        font-size: 1rem;
        background: #d4956a;
        color: #fff;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        font-weight: 600;
        font-family: inherit;
      }
      button:hover { opacity: 0.9; }
      .error {
        margin: 0;
        color: #c62828;
        font-size: 0.9rem;
      }
    </style>
  </body>
</html>
