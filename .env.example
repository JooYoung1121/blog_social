# Cloudinary — 사진 호스팅/변환
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Anthropic Claude — AI 글 자동 생성 (npm run generate-draft)
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# /admin 관리자 페이지
ADMIN_PASSWORD=set-a-strong-password
# 랜덤 32바이트 hex (예: openssl rand -hex 32)
ADMIN_SESSION_SECRET=replace-with-32-byte-hex
# main 브랜치 push 권한이 있는 GitHub PAT (Fine-grained: Contents Read+Write)
GITHUB_REPO_TOKEN=ghp_...
# 선택: 다른 레포에 커밋하려면 "owner/repo" 형식. 미설정 시 JooYoung1121/blog_social
# GITHUB_REPO=JooYoung1121/blog_social

# ── 네이버 검색광고 API (npm run keywords) ──────────────────────
# 연관키워드 + 월간검색수 + 경쟁정도. 2026-04-30 연관검색어 종료 이후
# 프로그램으로 키워드를 확장할 수 있는 사실상 유일한 공식 경로.
# 발급: https://searchad.naver.com → 도구 → API 사용 관리
# (광고 집행은 하지 않아도 계정만 만들면 발급 가능)
NAVER_AD_CUSTOMER_ID=
NAVER_AD_API_KEY=
NAVER_AD_SECRET_KEY=

# ── 네이버 검색 오픈 API (키워드별 블로그 문서수 = 경쟁도) ────────
# 발급: https://developers.naver.com/apps → 애플리케이션 등록 → 검색 API 선택
NAVER_OPENAPI_CLIENT_ID=
NAVER_OPENAPI_CLIENT_SECRET=

# 사이트
SITE_URL=https://jinas-holiday.vercel.app
